<UserControl x:Class="DiskUsage.Presentation.DiskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16" MinWidth="420">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" Command="{Binding RefreshCommand}"/>
            <TextBlock Text="{Binding Status}" Foreground="#A9B3BD" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat={}{0:0.#}%}"
                                       Foreground="#F4F7F5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DisplayName}" Foreground="#F4F7F5"/>
                        </DockPanel>
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"
                                     Foreground="#3FDDB2" Background="#2A3336" BorderThickness="0" Margin="0,3,0,2"/>
                        <TextBlock Text="{Binding Usage}" Foreground="#A9B3BD" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
