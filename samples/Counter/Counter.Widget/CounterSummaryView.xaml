<sdk:ModeTemplateView x:Class="Counter.Widget.CounterSummaryView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sdk="clr-namespace:Dora.Widget.SDK;assembly=Dora.Widget.SDK">
    <sdk:ModeTemplateView.NaturalTemplate>
        <DataTemplate>
            <DockPanel Margin="10,6" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Content="+" Width="30" Height="30" Margin="6,0,0,0"
                        Command="{Binding IncrementCommand}"/>
                <Button DockPanel.Dock="Right" Content="-" Width="30" Height="30"
                        Command="{Binding DecrementCommand}"/>
                <TextBlock Text="{Binding Count}" FontSize="28" FontWeight="SemiBold" Foreground="#E6E8EC"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
    </sdk:ModeTemplateView.NaturalTemplate>
    <sdk:ModeTemplateView.CompactTemplate>
        <DataTemplate>
            <DockPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E6E8EC"/>
                <TextBlock Text="Counter" FontSize="12" Foreground="#9AA3B2"/>
            </DockPanel>
        </DataTemplate>
    </sdk:ModeTemplateView.CompactTemplate>
    <sdk:ModeTemplateView.CollapsedTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Count, StringFormat=#{0}}" FontSize="11" Foreground="#E6E8EC" Margin="8,0"
                       VerticalAlignment="Center"/>
        </DataTemplate>
    </sdk:ModeTemplateView.CollapsedTemplate>
</sdk:ModeTemplateView>
