<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ModuleDock.ico</ApplicationIcon>
    <!-- exe name = release asset name (ModuleDock.exe): keep in sync with SelfUpdater.ExeAssetName and the release scripts -->
    <AssemblyName>ModuleDock</AssemblyName>
    <RootNamespace>Dora.Widget.Host</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-internal</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ModuleDock.ico" LogicalName="ModuleDock.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dora.Widget.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dora.Widget.Abstractions\Dora.Widget.Abstractions.csproj" />
    <ProjectReference Include="..\Dora.Widget.Runtime\Dora.Widget.Runtime.csproj" />
    <ProjectReference Include="..\Dora.Widget.SDK\Dora.Widget.SDK.csproj" />
  </ItemGroup>

  <!-- Sample widgets are built with the Host and dropped into widgets\<name>\ as plugins (never referenced in code). -->
  <ItemGroup Condition="'$(BundleSamples)' != 'false'">
    <ProjectReference Include="..\..\samples\Clock\Clock.Widget\Clock.Widget.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="..\..\samples\Counter\Counter.Widget\Counter.Widget.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="..\..\samples\DiskUsage\DiskUsage.Widget\DiskUsage.Widget.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <Target Name="CopySampleWidgets" AfterTargets="Build" Condition="'$(BundleSamples)' != 'false'">
    <ItemGroup>
      <ClockFiles Include="..\..\samples\Clock\Clock.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\Clock\Clock.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
      <DiskFiles Include="..\..\samples\DiskUsage\DiskUsage.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\DiskUsage\DiskUsage.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
      <CounterFiles Include="..\..\samples\Counter\Counter.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\Counter\Counter.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ClockFiles)" DestinationFolder="$(OutDir)widgets\Clock" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DiskFiles)" DestinationFolder="$(OutDir)widgets\DiskUsage" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CounterFiles)" DestinationFolder="$(OutDir)widgets\Counter" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish: the bundled widgets belong in the published folder too. -->
  <Target Name="CopySampleWidgetsToPublish" AfterTargets="Publish" Condition="'$(BundleSamples)' != 'false'">
    <ItemGroup>
      <PubClock Include="..\..\samples\Clock\Clock.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\Clock\Clock.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
      <PubDisk Include="..\..\samples\DiskUsage\DiskUsage.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\DiskUsage\DiskUsage.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
      <PubCounter Include="..\..\samples\Counter\Counter.Widget\bin\$(Configuration)\net8.0-windows\*.dll" Exclude="..\..\samples\Counter\Counter.Widget\bin\$(Configuration)\net8.0-windows\Dora.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PubClock)" DestinationFolder="$(PublishDir)widgets\Clock" />
    <Copy SourceFiles="@(PubDisk)" DestinationFolder="$(PublishDir)widgets\DiskUsage" />
    <Copy SourceFiles="@(PubCounter)" DestinationFolder="$(PublishDir)widgets\Counter" />
  </Target>

</Project>
